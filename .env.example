# מעתיקים ל-.env ומשלימים. בענן מגדירים את אותם שמות כמשתני סביבה / סודות.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# נתיב למסד הנתונים. בענן - להפנות לדיסק קבוע (volume), אחרת הנתונים יימחקו בכל הפעלה.
DATABASE_PATH=data/lab_data.db

# אופציונלי
# MAX_WORKERS=4            # כמה עמודים מעובדים במקביל
# PDF_ZOOM=3.0             # רזולוציית המרת PDF לתמונה
# CENTRAL_NUMBER_LENGTH=6  # 0 = ללא בדיקת אורך למספר מרכזי
# CHECK_ID_CHECKSUM=false  # true = בדיקת ספרת ביקורת בת.ז. (בדוגמאות השמות והמספרים שונו)
# REQUIRED_FIELDS=first_name,last_name,id_number,central_number,received_date,sending_entity,commitment_number
