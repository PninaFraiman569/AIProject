# מעתיקים לקובץ בשם .env (באותה תיקייה) ומשלימים.
# ב-Render מגדירים את אותם שמות במסך Environment של כל שירות.

# ---------- בקאנד
GEMINI_API_KEY=
GEMINI_MODEL=Gemini 2.5 Pro
# Supabase -> Connect -> Session pooler (לא Direct connection). להחליף את [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# המשתמש המשותף של הלבורנטיות. שינוי הסיסמה כאן + הפעלה מחדש = סיסמה חדשה (וכולן מנותקות)
APP_USERNAME=lab
APP_PASSWORD=

# ---------- פרונטאנד
BACKEND_URL=http://127.0.0.1:8000

# ---------- אופציונלי
# SESSION_MINUTES=60       # ניתוק אחרי כמה דקות ללא פעילות
# MAX_LOGIN_ATTEMPTS=5     # ניסיונות כניסה שגויים לפני חסימה של 5 דקות
# MAX_WORKERS=4            # כמה עמודים מפוענחים במקביל
# PDF_ZOOM=2.5             # רזולוציית המרת PDF לתמונה (2.5 = כ-180 DPI)
# CENTRAL_NUMBER_LENGTH=6  # 0 = ללא בדיקת אורך למספר מרכזי
# CHECK_ID_CHECKSUM=false  # true = בדיקת ספרת ביקורת בת.ז. (בדוגמאות המספרים שונו)
